NODE_ENV=development
PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taktchat_database
DB_USER=postgres
DB_PASS=altere-esta-senha

REDIS_URI=redis://localhost:6379/0
REDIS_URI_ACK=redis://localhost:6379/1
REDIS_URI_MSG_CONN=redis://localhost:6379/0
SOCKET_FALLBACK_NS_BROADCAST=true

JWT_SECRET=altere-este-secret-local
JWT_REFRESH_SECRET=altere-este-refresh-secret-local

SESSIONS_DRIVER=fs
SESSIONS_DIR=private/sessions

# WhatsApp Business API Oficial (opcional)
# WABA_WEBHOOK_VERIFY_TOKEN=altere-o-token
# WABA_API_VERSION=v18.0

# Logs Baileys (opcional)
# SUPPRESS_BAILEYS_DECRYPT_LOGS=1

# Label sync interno (apenas stack GHCR / serviço separado)
# LABEL_SYNC_INTERNAL_URL=http://taktchat-label-sync:8080
# LABEL_SYNC_INTERNAL_TOKEN=altere-este-token
